<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word"><head><meta charset="utf-8"><title>Signing Memo</title></head>
<body style="font-family:Tahoma,Arial,sans-serif;font-size:12pt"><h2 style="text-align:center">BTS Group - Signing Memo</h2>
<table style="border-collapse:collapse;width:100%"><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Request No.</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Subject / Agreement</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Counterparty</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Purpose</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Value</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Term</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Key terms and conditions</td><td style="border:1px solid #888;padding:8px;height:90px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">User Approver</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Coordinator</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr><tr><td style="width:32%;border:1px solid #888;padding:8px;font-weight:bold">Date</td><td style="border:1px solid #888;padding:8px;height:30px">&nbsp;</td></tr></table><p style="font-size:10pt;color:#555">Note: use the English version when a signing director is a foreign national.</p></body></html>