# Copy to .env and fill in. NEVER commit .env.

# Supabase > Project Settings > Database > Connection string > "Session pooler" (URI)
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API  (for file attachments; leave empty to store files on local disk)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=attachments

PORT=3001

# --- Sign-in (see AUTH.md) ---
# Public address of the site, no trailing slash. Local: http://localhost:5173
APP_URL=http://localhost:5173
# Random string that signs login cookies: openssl rand -hex 32
SESSION_SECRET=
# Who may sign in (comma separated). Required in production, otherwise nobody gets in.
ALLOWED_EMAIL_DOMAINS=yourcompany.com
ALLOWED_EMAILS=
# Who may approve / move requests forward (comma-separated emails). Empty = every signed-in user.
APPROVER_EMAILS=
# Companies / departments offered in the request form (comma separated). Defaults: Turtle23 / free text
COMPANIES=Turtle23
DEPARTMENTS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft 365: MS_TENANT is your Directory (tenant) ID
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=
# Local testing only: lets anyone in with a "Demo User" account when no provider is set up
# ALLOW_DEMO_LOGIN=true
